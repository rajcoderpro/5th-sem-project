# Copy this file to .env and fill in your own values.
MONGOOSE_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# For a frontend and backend on different sites in production, use COOKIE_SAME_SITE=none.
COOKIE_SAME_SITE=lax
# Set TRUST_PROXY=true only when the backend runs behind one trusted reverse proxy.
TRUST_PROXY=false

# Attendance configuration (all times are India Standard Time)
ATTENDANCE_SHIFT_START=09:30
ATTENDANCE_GRACE_MINUTES=15
ATTENDANCE_HALF_DAY_MINUTES=240

# Google Gemini API (keep this key on the backend only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
